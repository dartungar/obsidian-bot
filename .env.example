# Existing Telegram/API settings (use distinct strong API tokens).
OBSIDIAN_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
OBSIDIAN_AGENT_API_TOKEN=
OBSIDIAN_REVIEW_API_TOKEN=
BUTLER_TIMEZONE=Asia/Tbilisi

# Enable managed headless sync after stopping any other sync client for /var/obsidian.
OBSIDIAN_SYNC_ENABLED=true
# Prefer the remote vault ID; a unique vault name also works.
OBSIDIAN_SYNC_VAULT=
# Supply a token OR run the one-time login command documented in README.md.
OBSIDIAN_AUTH_TOKEN=
# Required during setup for an end-to-end encrypted vault.
OBSIDIAN_SYNC_PASSWORD=
OBSIDIAN_SYNC_INTERVAL_SECONDS=25
OBSIDIAN_SYNC_TIMEOUT_SECONDS=180
OBSIDIAN_SYNC_INITIAL_TIMEOUT_SECONDS=1800
# Explicitly opt in to adoption of a nonempty local vault; a ZIP backup is created first.
OBSIDIAN_SYNC_ADOPT_EXISTING=false
# Creates a missing remote vault using the supplied name and end-to-end encryption.
OBSIDIAN_SYNC_CREATE_REMOTE=false
